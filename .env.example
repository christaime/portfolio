# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Express server listener port (defaults to 3000 if not provided by host platform like Vercel/Cloud Run)
PORT=3000

# EMAILJS CONFIGURATION (Recommended: Works with free Gmail / Outlook / Yahoo without a custom domain!):
# 1. Create a free account at https://www.emailjs.com/
# 2. Add an Email Service connected to your personal email (e.g. Gmail) -> get EMAILJS_SERVICE_ID
# 3. Create Email Templates for OTP verification and Contact form messages -> get EMAILJS_TEMPLATE_ID
# 4. In Account > General, copy Public Key -> EMAILJS_PUBLIC_KEY
# 5. (Optional) In Account > Security, copy Private Key -> EMAILJS_PRIVATE_KEY
EMAILJS_SERVICE_ID="service_your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="template_your_contact_template_id"
EMAILJS_OTP_TEMPLATE_ID="template_your_otp_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# RECIPIENT EMAIL: Where contact messages should be delivered
RECIPIENT_EMAIL="mnchristelle@gmail.com"

# GOOGLE RECAPTCHA V3 CONFIGURATION:
# Obtain keys from Google reCAPTCHA Admin Console (v3 Score-based)
VITE_RECAPTCHA_SITE_KEY="your_recaptcha_v3_site_key"
RECAPTCHA_SECRET_KEY="your_recaptcha_v3_secret_key"

# Required for 24-hour email verification caching across server restarts.
# You can obtain free Redis REST credentials from https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
REDIS_URL="redis://default:password@localhost:6379"
